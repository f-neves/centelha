#!/bin/sh
# Reprova commit com termo proibido em nome ou conteúdo de arquivo, ou com
# metadado de IA em imagem (R9, R11). Olha o que está no índice, não o disco.
. "$(dirname "$0")/termos.sh"

falhou=0
lista=$(mktemp)
git diff --cached --name-only --diff-filter=ACMR > "$lista"

while IFS= read -r arquivo; do
	[ -z "$arquivo" ] && continue
	nome=$(printf '%s' "$arquivo" | achados_texto_e_palavra)
	if [ -n "$nome" ]; then
		echo "pre-commit: nome de arquivo com termo proibido: $arquivo" >&2
		falhou=1
	fi
	case "$arquivo" in
	*.webp | *.png | *.jpg | *.jpeg | *.gif | *.ico | *.avif)
		if git show ":$arquivo" | grep -a -q -i -E "$TERMOS_BINARIO"; then
			echo "pre-commit: imagem com metadado proibido: $arquivo (rode a limpeza do sync-content)" >&2
			falhou=1
		fi
		;;
	*)
		achado=$(git show ":$arquivo" | achados_texto_e_palavra | tr '\n' ' ')
		if [ -n "$achado" ]; then
			echo "pre-commit: termo proibido em $arquivo: $achado" >&2
			falhou=1
		fi
		;;
	esac
done < "$lista"
rm -f "$lista"

exit $falhou
